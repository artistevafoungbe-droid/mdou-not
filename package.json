{
  "name": "mdou-not",
  "version": "1.0.0",
  "description": "Application mobile pour envoyer des notifications et messages programmés via WhatsApp et SMS",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest"
  },
  "dependencies": {
    "expo": "^50.0.0",
    "expo-notifications": "^0.27.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-navigation": "^6.1.9",
    "react-navigation-native": "^6.1.9",
    "react-navigation-bottom-tabs": "^6.5.11",
    "react-navigation-stack": "^6.3.20",
    "firebase": "^10.7.0",
    "@react-native-firebase/app": "^18.8.0",
    "@react-native-firebase/auth": "^18.8.0",
    "@react-native-firebase/database": "^18.8.0",
    "@react-native-firebase/firestore": "^18.8.0",
    "twilio": "^4.1.0",
    "axios": "^1.6.0",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-vector-icons": "^10.0.3",
    "date-fns": "^2.30.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0"
  },
  "expo": {
    "name": "mdou-not",
    "slug": "mdou-not",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.artistevafoungbe.mdounot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.artistevafoungbe.mdounot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
